# Copy to .env (git-ignored) for local development.

# --- Gemini ------------------------------------------------------------
GEMINI_API_KEY=your-key-from-aistudio.google.com
# demo default (cheapest current model):
GEMINI_MODEL=gemini-3.5-flash-lite
# best quality, cost ignored:
# GEMINI_MODEL=gemini-4-argon
# use Vertex AI + service account instead of an API key:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=my-project
# GOOGLE_CLOUD_LOCATION=global

# --- Models ------------------------------------------------------------
EMBED_BACKEND=qwen                       # qwen | hash (offline tests only)
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B    # or Qwen3-Embedding-4B / -8B on a GPU
RERANK_BACKEND=none                    # qwen | bge | none
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B    # or Qwen3-Reranker-4B / -8B on a GPU

# --- Vector store (empty = embedded local Qdrant in data/qdrant) --------
QDRANT_URL=
QDRANT_API_KEY=

# --- Retrieval knobs ---------------------------------------------------
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
DENSE_K=30
SPARSE_K=30
FINAL_K=5
MIN_RELEVANCE=0.15

# --- Frontend ----------------------------------------------------------
BACKEND_URL=http://localhost:8080
